{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "landau-bridge",
  "identifier": "ir.landau.bridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3210",
    "beforeBuildCommand": "pnpm generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      { "title": "پل لاندا", "width": 1200, "height": 800, "minWidth": 960, "minHeight": 640, "backgroundColor": "#0b0d12" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNUQxNjE1NEM0M0M5MUEKUldRYXlVTk1GUlpkK2lxV05GQy9FSmhDcFl0dVR1UGNJWTRyMHlUWDQ5L1pTYUdSMVg5MWFpa2QK",
      "endpoints": ["https://github.com/vhidvz/landau-bridge/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
