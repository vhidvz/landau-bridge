{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "landau-bridge",
  "version": "0.1.0",
  "identifier": "ir.landau.bridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3210",
    "beforeBuildCommand": "pnpm generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      { "title": "پل لاندا", "width": 1200, "height": 800, "minWidth": 960, "minHeight": 640, "backgroundColor": "#0b0d12" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
